# ─── MongoDB ────────────────────────────────────────────────────────────────
# Dùng MongoDB Atlas (thay bằng connection string thực của bạn):
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vuavuive?retryWrites=true&w=majority

# Hoặc MongoDB local:
# MONGO_URI=mongodb://localhost:27017/vuavuive

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Session ────────────────────────────────────────────────────────────────
SESSION_SECRET=
SESSION_MAX_AGE_MS=604800000

# ─── CORS ───────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:4200
# Multi-origin (recommended): comma-separated list for customer/admin portals
# CLIENT_ORIGINS=http://localhost:4200,http://localhost:4201

# Reverse proxy (Render/Railway/Fly) - required in production for secure cookies
# TRUST_PROXY=1

# ─── ML Recommender API ─────────────────────────────────────────────────────
# Production example: https://vuavuive-ml.onrender.com
RECOMMENDER_API=https://vuavuive-ml.onrender.com

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Lấy từ Google Cloud Console → APIs & Services → Credentials
# https://console.cloud.google.com/
# Must match the frontend client ID; authorize the production frontend origin in Google Cloud.
GOOGLE_CLIENT_ID=

# ─── Email SMTP (Password Reset OTP) ────────────────────────────────────────
RESEND_API_KEY=
# onboarding@resend.dev is testing-only; production must use an address on a verified domain.
RESEND_FROM_EMAIL=onboarding@resend.dev
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@vuavuive.vn
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=15

# ─── VNPay Sandbox (TEST ONLY) ─────────────────────────────────────────────
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:4200/checkout/return
BACKEND_PUBLIC_URL=http://localhost:3000
CUSTOMER_PORTAL_BASE=http://localhost:4200
ADMIN_PORTAL_BASE=http://localhost:4201
# Production: thay bằng mã thật từ https://sandbox.vnpayment.vn

# ─── MoMo Test (TEST ONLY) ─────────────────────────────────────────────────
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CREATE_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REQUEST_TYPE=payWithMethod
MOMO_REDIRECT_URL=http://localhost:4200/checkout/momo-return
MOMO_IPN_URL=https://your-public-domain-or-ngrok/api/payment/momo/ipn
# Production: thay bằng Partner Code, Access Key, Secret Key thật từ https://developers.momo.vn
GEMINI_API_KEY=
GEMINI_TIMEOUT_MS=12000

# Production/staging isolation; inject secrets through hosting secret store.
CLIENT_ORIGINS=http://localhost:4200,http://localhost:4201
UPLOAD_DIR=
APP_ENV=local
# Render Free demo only: APP_ENV=staging, UPLOAD_STORAGE_MODE=ephemeral,
# UPLOAD_DIR=/tmp/vuavuive-staging-uploads; MONGO_URI must name a *_staging DB.
# Real production: APP_ENV=production, UPLOAD_STORAGE_MODE=persistent, mounted UPLOAD_DIR.
UPLOAD_STORAGE_MODE=persistent
ML_API_TOKEN=
VNPAY_ENABLED=false
MOMO_ENABLED=false
VNPAY_DEV_ALLOW_RETURN_SIG_BYPASS=false
MOMO_DEV_ALLOW_RETURN_SIG_BYPASS=false
ORDER_PAYMENT_TTL_MINUTES=30
ALLOW_TEST_DATA=false
QA_FIXTURE_PASSWORD=
